# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://helpdesk:helpdesk@localhost:5433/helpdesk
REDIS_URL=redis://localhost:6380
# Redis key namespace for the job queues. Leave it alone: `bull` is where the
# worker reads. `npm test` uses `hd-test` and the intake benchmark `hd-bench`,
# so their short-lived tickets are never triaged by a running worker.
# QUEUE_PREFIX=bull

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------
# Resolved by the SDK from ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN, or an
# `ant auth login` profile. Leave unset to run the dashboard without triage.
ANTHROPIC_API_KEY=
TRIAGE_MODEL=claude-opus-5
DRAFT_MODEL=claude-opus-5
# low | medium | high | xhigh | max  (triage is a classification task: low is right)
TRIAGE_EFFORT=low

# Embeddings. `hash` is a deterministic local stub for dev/tests with no key.
# `openai` uses text-embedding-3-small (1536 dims, matches the schema).
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Autonomy. This is the dial the phase plan turns.
#   shadow  - agent classifies and drafts; nothing is ever sent   (phase 2-3)
#   assist  - drafts land in a human review queue                 (phase 3)
#   auto    - per-category autonomy from businesses.settings      (phase 4+)
# ---------------------------------------------------------------------------
AGENT_MODE=shadow

# Per-tenant cost ceiling, USD per day. Exceeding it fails LLM calls loudly.
LLM_DAILY_COST_CAP_USD=25

# ---------------------------------------------------------------------------
# Intake
# ---------------------------------------------------------------------------
# Legacy shared secret for the inbound-email webhook. The tenant normally comes
# from a per-tenant token in `businesses.intake_token`, sent as
# `x-intake-token`. This secret authenticates the provider instead, and on its
# own is only honoured on a single-tenant deployment: it cannot name a tenant,
# and guessing "the first business" is how one company receives another's mail.
# Sent together with `x-delivered-to`, the address picks the tenant — but the
# address is never enough without the secret, since anybody can learn it.
INTAKE_WEBHOOK_SECRET=dev-secret-change-me
# Signs requester portal links and the unsubscribe links in notifications.
# Rotating it invalidates every issued link of both kinds. The two purposes are
# domain-separated inside the signature, so an unsubscribe link is not also a
# portal capability for that person's ticket history.
PORTAL_SECRET=dev-portal-secret-change-me
# Where the console lives, for links in outbound mail. A notification with no
# link asks the reader to go and find the ticket themselves.
APP_BASE_URL=http://localhost:3000
# Folder the dev intake poller watches for .eml files.
INTAKE_MAILDIR=./db/seed/inbox
# Names this worker's heartbeat row, which is what /healthz reads to decide
# whether anything is consuming the queues. Stable per process *role* rather
# than per process, so a restart updates the row instead of accumulating one
# per boot — a deployment running two workers gives each a distinct id.
WORKER_ID=worker

# ---------------------------------------------------------------------------
# Outbound mail
# ---------------------------------------------------------------------------
# How a reply actually leaves the building.
#   spool    - renders the real message and writes it to a folder. The whole
#              delivery path runs (queue, claim, retry, status, history) and no
#              stranger receives a test email. The development default, for the
#              same reason `hash` is the default embedder.
#   smtp     - a real server, over nodemailer, with a connection pool
#   postmark - the transactional API, over fetch. Bounces and complaints come
#              back to /api/outbound/events
#   none     - this deployment sends nothing. Replies are recorded and parked
#              as `cancelled`, so nothing accumulates retries against a
#              transport that is never coming.
OUTBOUND_EMAIL_PROVIDER=spool

# Fallback From address. A tenant with an `intake_address` sends from that
# instead, so a reply to our reply arrives back in the same tenant's intake.
OUTBOUND_FROM_ADDRESS=helpdesk@localhost
OUTBOUND_FROM_NAME=IT Support
# Right-hand side of the Message-IDs we mint. Must be a domain you own: it is
# what an inbound bounce quotes back, and how it is matched to the message.
OUTBOUND_MESSAGE_ID_DOMAIN=helpdesk.local
# Where the `spool` transport writes. One .eml per message.
OUTBOUND_SPOOL_DIR=./db/seed/outbox
# Attempts before a message becomes a dead letter. Five, with the backoff in
# `retryDelayMs`, spans a little over two hours: long enough to ride out a
# provider incident, short enough that somebody still cares when it lands in
# the failed queue.
OUTBOUND_MAX_ATTEMPTS=5

# SMTP. Either a URL, or the parts. 587 negotiates STARTTLS and refuses to fall
# back to plaintext; set SMTP_SECURE=true only for implicit TLS on 465.
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Postmark server token (not the account token).
POSTMARK_SERVER_TOKEN=

# ---------------------------------------------------------------------------
# Authentication and secrets at rest
# ---------------------------------------------------------------------------
# Console sessions need no secret here: the cookie carries a 32-byte random
# token and the database stores only its SHA-256, so there is nothing to sign
# and a database dump is not a set of working logins. Sessions are revoked by
# updating the row, which a signed stateless cookie could not offer.

# AES-256-GCM key for integration credentials in `integration_credentials`.
# Any length is accepted and hashed to 32 bytes, so rotating to a longer secret
# needs no code change. Unset in development gets a warning and a fixed
# development key; unset with NODE_ENV=production is a refusal to start, because
# silently encrypting production secrets under a key from the source tree is
# worse than not booting. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_KEY=
